triggerHitmarker = function(player)
    if not (hitmarkerSettings.enabled or (Toggles.HitmarkerToggle and Toggles.HitmarkerToggle.Value)) then return end

    local is_2d = hitmarkerSettings.style == "2D"
    local linesList = {}

    for i = 1, 4 do
        linesList[i] = {
            outline = Drawing.new("Line"),
            line = Drawing.new("Line")
        }
        linesList[i].outline.Thickness = 3
        linesList[i].outline.ZIndex = 1
        linesList[i].outline.Color = Color3.fromRGB(0, 0, 0)
        linesList[i].outline.Visible = false

        linesList[i].line.Thickness = 1
        linesList[i].line.ZIndex = 2
        linesList[i].line.Color = hitmarkerSettings.color
        linesList[i].line.Visible = false
    end

    local time_elapsed = 0
    local renderConn = nil
    local gap = hitmarkerSettings.gap
    local size = hitmarkerSettings.size
    local color = hitmarkerSettings.color

    local targetPos3D = (player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")) and player.Character.HumanoidRootPart.Position

    renderConn = RunService.Heartbeat:Connect(function(dt)
        time_elapsed = time_elapsed + dt
        local alpha = math.clamp(time_elapsed / 0.6, 0, 1)
        local tween_value = math.sin(alpha * math.pi / 2)
        local transparency = 1 - tween_value

        if alpha >= 1 then
            if renderConn then renderConn:Disconnect() renderConn = nil end
            for i = 1, 4 do
                pcall(function() linesList[i].line:Destroy() end)
                pcall(function() linesList[i].outline:Destroy() end)
            end
            return
        end

        local centerPos = nil
        if is_2d then
            centerPos = UserInputService:GetMouseLocation()
        else
            if targetPos3D then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos3D)
                if onScreen then
                    centerPos = Vector2.new(screenPos.X, screenPos.Y)
                end
            end
        end

        if centerPos then
            for i = 1, 4 do
                local offset = hitmarkerOffsets[i]
                local offset_pos = offset * gap
                local l = linesList[i].line
                local o = linesList[i].outline

                l.Visible = true
                o.Visible = true
                l.From = centerPos + offset_pos
                l.To = l.From + offset * size
                l.Color = color
                l.Transparency = transparency
                o.Transparency = transparency
                o.From = l.From
                o.To = l.To
            end
        else
            for i = 1, 4 do
                linesList[i].line.Visible = false
                linesList[i].outline.Visible = false
            end
        end
    end)
end

