    local function CopyAnimationsFromPlayer(inGamePlayer, userId)
        local char = LocalPlayer.Character
        if not char then return false end
        local myAnimate = char:FindFirstChild("Animate")
        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not myAnimate then return false end

        local copied = false

        if inGamePlayer and inGamePlayer.Character then
            local targetAnimate = inGamePlayer.Character:FindFirstChild("Animate")
            if targetAnimate then
                local animCategories = {"idle", "walk", "run", "jump", "fall", "climb", "swim", "toolnone"}
                for _, cat in ipairs(animCategories) do
                    local targetCat = targetAnimate:FindFirstChild(cat)
                    local myCat = myAnimate:FindFirstChild(cat)
                    if targetCat and myCat then
                        for _, targetAnim in pairs(targetCat:GetChildren()) do
                            if targetAnim:IsA("Animation") and targetAnim.AnimationId and targetAnim.AnimationId ~= "" then
                                local myAnim = myCat:FindFirstChild(targetAnim.Name)
                                if myAnim and myAnim:IsA("Animation") then
                                    myAnim.AnimationId = targetAnim.AnimationId
                                    copied = true
                                elseif not myAnim then
                                    local clone = targetAnim:Clone()
                                    clone.Parent = myCat
                                    copied = true
                                end
                            end
                        end
                    end
                end
            end
        end

        if not copied and userId then
            pcall(function()
                local desc = Players:GetHumanoidDescriptionFromUserId(userId)
                if not desc then return end

                local animPackages = {
                    { id = desc.IdleAnimation, folders = {"idle"} },
                    { id = desc.WalkAnimation, folders = {"walk"} },
                    { id = desc.RunAnimation,  folders = {"run"} },
                    { id = desc.JumpAnimation, folders = {"jump"} },
                    { id = desc.FallAnimation, folders = {"fall"} },
                    { id = desc.ClimbAnimation, folders = {"climb"} },
                    { id = desc.SwimAnimation, folders = {"swim"} },
                }

                for _, pkg in ipairs(animPackages) do
                    if pkg.id and pkg.id > 0 then
                        local ok, objs = pcall(function()
                            return game:GetObjects("rbxassetid://" .. tostring(pkg.id))
                        end)
                        if ok and objs and #objs > 0 then
                            for _, folderName in ipairs(pkg.folders) do
                                local myCat = myAnimate:FindFirstChild(folderName)
                                if myCat then
                                    for _, item in pairs(objs[1]:GetDescendants()) do
                                        if item:IsA("Animation") and item.AnimationId and item.AnimationId ~= "" then
                                            local myAnim = myCat:FindFirstChild(item.Name) or myCat:FindFirstChildOfClass("Animation")
                                            if myAnim then
                                                myAnim.AnimationId = item.AnimationId
                                                copied = true
                                            end
                                        end
                                    end
                                    if objs[1]:IsA("Animation") and objs[1].AnimationId ~= "" then
                                        local myAnim = myCat:FindFirstChildOfClass("Animation")
                                        if myAnim then
                                            myAnim.AnimationId = objs[1].AnimationId
                                            copied = true
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end

        if copied then
            pcall(function()
                if animator then
                    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                    end
                end
                myAnimate.Disabled = true
                task.wait(0.05)
                myAnimate.Disabled = false
            end)
        end

        return copied
    end

