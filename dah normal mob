    local ExtraGroup = Tabs.character:AddRightGroupbox('Extra')

    local function MorphPlayerSkinAndBody(inGamePlayer, userId)
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end

        local function applyScales(sourceHum)
            if not sourceHum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
            local scaleNames = {
                "BodyHeightScale", "BodyWidthScale", "BodyDepthScale",
                "HeadScale", "BodyTypeScale", "BodyProportionsScale"
            }
            for _, sName in ipairs(scaleNames) do
                local sVal = sourceHum:FindFirstChild(sName)
                if sVal and sVal:IsA("NumberValue") then
                    local myVal = hum:FindFirstChild(sName)
                    if myVal and myVal:IsA("NumberValue") then
                        myVal.Value = sVal.Value
                    elseif not myVal then
                        local newVal = sVal:Clone()
                        newVal.Parent = hum
                    end
                end
            end
        end

        local function copyLimbVisual(targetPart, myPart)
            if not targetPart or not myPart then return end

            if targetPart.Name == "Head" then
                local targetFace = targetPart:FindFirstChild("face")
                local myFace = myPart:FindFirstChild("face")
                if targetFace and targetFace:IsA("Decal") then
                    if not myFace then
                        myFace = Instance.new("Decal")
                        myFace.Name = "face"
                        myFace.Face = Enum.NormalId.Front
                        myFace.Parent = myPart
                    end
                    myFace.Texture = targetFace.Texture
                    myFace.Transparency = targetFace.Transparency
                end

                local targetMesh = targetPart:FindFirstChildOfClass("SpecialMesh")
                if targetMesh then
                    local myMesh = myPart:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh")
                    myMesh.MeshType = targetMesh.MeshType
                    myMesh.MeshId = targetMesh.MeshId
                    myMesh.TextureId = targetMesh.TextureId
                    myMesh.Scale = targetMesh.Scale
                    myMesh.Offset = targetMesh.Offset
                    myMesh.Parent = myPart
                end
            else
                local targetMesh = targetPart:FindFirstChildOfClass("SpecialMesh")
                if targetMesh then
                    local myMesh = myPart:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh")
                    myMesh.MeshType = targetMesh.MeshType
                    myMesh.MeshId = targetMesh.MeshId
                    myMesh.TextureId = targetMesh.TextureId
                    myMesh.Scale = targetMesh.Scale
                    myMesh.Offset = targetMesh.Offset
                    myMesh.Parent = myPart
                elseif targetPart:IsA("MeshPart") then
                    local myMesh = myPart:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh")
                    myMesh.MeshType = Enum.MeshType.FileMesh
                    myMesh.MeshId = targetPart.MeshId
                    myMesh.TextureId = targetPart.TextureID
                    myMesh.Scale = Vector3.new(1, 1, 1)
                    myMesh.Parent = myPart
                end
            end

            pcall(function()
                myPart.Color = targetPart.Color
                myPart.Material = targetPart.Material
                myPart.Transparency = targetPart.Transparency
            end)
        end

        local function clearCurrentClothingAndAccessories()
            for _, v in pairs(char:GetChildren()) do
                if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("CharacterMesh") or v:IsA("ShirtGraphic") then
                    v:Destroy()
                end
            end
        end

        if inGamePlayer and inGamePlayer.Character then
            local targetChar = inGamePlayer.Character
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

            clearCurrentClothingAndAccessories()

            local targetColors = targetChar:FindFirstChildOfClass("BodyColors")
            local myColors = char:FindFirstChildOfClass("BodyColors")
            if targetColors then
                if myColors then myColors:Destroy() end
                targetColors:Clone().Parent = char
            end

            for _, item in pairs(targetChar:GetChildren()) do
                if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
                    item:Clone().Parent = char
                elseif item:IsA("Accessory") then
                    pcall(function()
                        hum:AddAccessory(item:Clone())
                    end)
                end
            end

            if targetHum then
                applyScales(targetHum)
            end

            local limbNames = {
                "Head", "UpperTorso", "LowerTorso", "Torso",
                "LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm",
                "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm",
                "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "Left Leg",
                "RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg"
            }

            for _, limbName in ipairs(limbNames) do
                local targetLimb = targetChar:FindFirstChild(limbName)
                local myLimb = char:FindFirstChild(limbName)
                if targetLimb and myLimb then
                    copyLimbVisual(targetLimb, myLimb)
                end
            end

            local parent = char.Parent
            char.Parent = nil
            char.Parent = parent
            return true
        end

        if userId then
            local descSuccess, desc = pcall(function()
                return Players:GetHumanoidDescriptionFromUserId(userId)
            end)

            if descSuccess and desc then
                local appliedNative = pcall(function()
                    hum:ApplyDescription(desc)
