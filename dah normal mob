local function getSkinOptionsForWeapon(wep)
    local options = {}
    local cleanWep = wep:gsub("[%[%]]", "")
    local bracketWep = "[" .. cleanWep .. "]"
    
    local targetTable = skin_table and (skin_table[wep] or skin_table[bracketWep] or skin_table[cleanWep])
    if targetTable then
        for skinName in pairs(targetTable) do
            table.insert(options, skinName)
        end
    end
    table.sort(options)
    if #options == 0 then
        table.insert(options, "None")
    end
    return options
end

