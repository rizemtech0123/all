local pendingSkinData = nil

local applySkin = function(tool, skin, knife)
    if not tool or not tool:FindFirstChild("Default") then return end
    local default = tool.Default

    if skin == nil then
        for _, child in default:GetChildren() do
            child:Destroy()
        end
        default.Transparency = 0
        return
    end

    local skin_object = skins[skin]
    local cleanName = tool.Name:gsub("[%[%]]", "")
    local bracketName = "[" .. cleanName .. "]"
    local skin_table_object = (skin_table[tool.Name] and skin_table[tool.Name][skin])
        or (skin_table[bracketName] and skin_table[bracketName][skin])
        or (skin_table[cleanName] and skin_table[cleanName][skin])
    if not skin_table_object then return end

    local texture_id = skin_table_object["TextureID"]
    local cframe = skin_table_object["CFrame"]
    local particle = skin_object and skin_object.Particle

    local pullout_anim = skin_object and skin_object["PulloutAnimation"]
    local pullout_sound = skin_object and skin_object["PulloutSound"]
    local pullout_volume = skin_object and skin_object["PulloutVolume"] or 1

    for _, child in default:GetChildren() do
        child:Destroy()
    end

    if particle then
        local new_particle = particle:Clone()
        new_particle.Parent = default
    end

    local skin_converted = skin_object and skin_object["Convert"] or skin

    if typeof(texture_id) == "string" then
        default.TextureID = texture_id
        default.Transparency = 0
    else
        local reps = game:GetService("ReplicatedStorage")
        local skinModules = reps:FindFirstChild("SkinModules")
        if skinModules then
            local isKnife = knife or cleanName == "Knife"
            local categoryFolder = skinModules:FindFirstChild(isKnife and "Knives" or "Meshes")
            local new_default = categoryFolder and categoryFolder:FindFirstChild(skin_converted)
            
            if not new_default then
                default.Transparency = 0
                return
            end

            if isKnife then
                default.Transparency = 1
            end

            new_default = isKnife and new_default:Clone() or (texture_id and new_default:FindFirstChild(texture_id.Name) and new_default[texture_id.Name]:Clone())
            if new_default then
                local new_weld = Instance.new("Weld")
                
                new_default.Parent = default
                new_weld.Parent = new_default

                new_weld.Part0 = default
                new_weld.Part1 = new_default
                new_weld.C0 = cframe or new_weld.C0
                default.Transparency = 1
            end
        end
    end

    local handle = tool:FindFirstChild("Handle")
    if handle then
        pcall(function() handle:SetAttribute("SkinName", skin or "") end)
    end

    pendingSkinData = {
        pullout_anim = pullout_anim,
        pullout_sound = pullout_sound,
        pullout_volume = pullout_volume,
        is_knife = knife or cleanName == "Knife"
    }
end

local function setupSkinChangerListener(character)
    if not character then return end
    character.ChildAdded:Connect(function(object)
        if Toggles.enable_skin_changer and Toggles.enable_skin_changer.Value then
            if object:IsA("Tool") then
                local cleanName = object.Name:gsub("[%[%]]", "")
                local skin = skins["equipped"][object.Name] 
                    or skins["equipped"]["[" .. cleanName .. "]"] 
                    or skins["equipped"][cleanName]
                if skin then
                    task.delay(0, function()
                        applySkin(object, skin, cleanName == "Knife")
                    end)
                end

                if pendingSkinData then
                    if pendingSkinData.pullout_sound and object:FindFirstChild("Handle") then
                        local s = Instance.new("Sound")
                        s.SoundId = pendingSkinData.pullout_sound
                        s.Volume = pendingSkinData.pullout_volume
                        s.Parent = object.Handle
                        s:Play()
                        s.Ended:Connect(function() s:Destroy() end)
                    end

                    if pendingSkinData.pullout_anim and character:FindFirstChild("Humanoid") then
                        local anim = Instance.new("Animation")
                        anim.AnimationId = pendingSkinData.pullout_anim
                        local track = character.Humanoid:LoadAnimation(anim)
                        track:Play()
                        anim:Destroy()
                        task.delay(1.2, function() track:Stop() end)
                    end

                    if pendingSkinData.shoot_sound and object:FindFirstChild("Handle") then
                        local shootSound = object.Handle:FindFirstChild("ShootSound") or object.Handle:FindFirstChild("Shot") or object.Handle:FindFirstChild("Fire")
                        if shootSound and shootSound:IsA("Sound") then
                            shootSound.SoundId = pendingSkinData.shoot_sound
                        end
                    end

