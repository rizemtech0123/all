                    char.Parent = nil
                    char.Parent = parent
                    return true
                end

                local function getDescVal(prop)
                    local ok, val = pcall(function() return desc[prop] end)
                    return (ok and val) or nil
                end

                if hum.RigType == Enum.HumanoidRigType.R15 then
                    local scaleProps = {
                        BodyHeightScale = getDescVal("HeightScale"),
                        BodyWidthScale = getDescVal("WidthScale"),
                        BodyDepthScale = getDescVal("DepthScale"),
                        HeadScale = getDescVal("HeadScale"),
                        BodyTypeScale = getDescVal("BodyTypeScale"),
                        BodyProportionsScale = getDescVal("ProportionScale") or getDescVal("ProportionsScale"),
                    }
                    for name, val in pairs(scaleProps) do
                        if val and type(val) == "number" and val > 0 then
                            local sVal = hum:FindFirstChild(name)
                            if sVal and sVal:IsA("NumberValue") then
                                sVal.Value = val
                            elseif not sVal then
                                local newVal = Instance.new("NumberValue")
                                newVal.Name = name
                                newVal.Value = val
                                newVal.Parent = hum
                            end
                        end
                    end
                end

                local bodyBundleParts = {
                    { id = getDescVal("Torso"), parts = {"UpperTorso", "LowerTorso", "Torso"} },
                    { id = getDescVal("LeftArm"), parts = {"LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm"} },
                    { id = getDescVal("RightArm"), parts = {"RightUpperArm", "RightLowerArm", "RightHand", "Right Arm"} },
                    { id = getDescVal("LeftLeg"), parts = {"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "Left Leg"} },
                    { id = getDescVal("RightLeg"), parts = {"RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg"} },
                    { id = getDescVal("Head"), parts = {"Head"} },
                }

                for _, bundleInfo in ipairs(bodyBundleParts) do
                    if bundleInfo.id and bundleInfo.id > 0 then
                        pcall(function()
                            local objs = game:GetObjects("rbxassetid://" .. tostring(bundleInfo.id))
                            if objs and #objs > 0 then
                                for _, partName in ipairs(bundleInfo.parts) do
                                    local myLimb = char:FindFirstChild(partName)
                                    if myLimb then
                                        for _, item in pairs(objs[1]:GetDescendants()) do
                                            if item:IsA("SpecialMesh") then
                                                local myMesh = myLimb:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh")
                                                myMesh.MeshType = item.MeshType
                                                myMesh.MeshId = item.MeshId
                                                myMesh.TextureId = item.TextureId
                                                myMesh.Scale = item.Scale
                                                myMesh.Offset = item.Offset
                                                myMesh.Parent = myLimb
                                            elseif item:IsA("MeshPart") and item.Name:lower():find(partName:lower()) then
                                                local myMesh = myLimb:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh")
                                                myMesh.MeshType = Enum.MeshType.FileMesh
                                                myMesh.MeshId = item.MeshId
                                                myMesh.TextureId = item.TextureID
                                                myMesh.Scale = Vector3.new(1, 1, 1)
                                                myMesh.Parent = myLimb
                                            end
                                        end
                                    end
                                end
                            end
                        end)
                    end
                end
            end

            local success, appearance = pcall(function()
                return Players:GetCharacterAppearanceAsync(userId)
            end)
            if success and appearance then
                clearCurrentClothingAndAccessories()

                for _, v in pairs(appearance:GetChildren()) do
                    if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                        v.Parent = char
                    elseif v:IsA("Accessory") then
                        pcall(function() hum:AddAccessory(v) end)
                    elseif v.Name == "R15" and hum.RigType == Enum.HumanoidRigType.R15 then
                        local mesh = v:FindFirstChildOfClass("CharacterMesh")
                        if mesh then mesh.Parent = char end
                    end
                end

                if appearance:FindFirstChild("face") then
                    appearance.face.Parent = char.Head
                elseif not char.Head:FindFirstChild("face") then
                    local face = Instance.new("Decal")
                    face.Face = Enum.NormalId.Front
                    face.Name = "face"
                    face.Texture = "rbxasset://textures/face.png"
                    face.Parent = char.Head
                end

                local parent = char.Parent
                char.Parent = nil
                char.Parent = parent
                return true
            end
        end

        return false
    end

