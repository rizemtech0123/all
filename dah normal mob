local function emitHitParticles(target, hitPart)
    if not (hitParticleSettings.enabled or (Toggles.HitParticlesToggle and Toggles.HitParticlesToggle.Value)) then return end
    if not target or not target.Character then return end
    local root = target.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    hitParticlePart.CFrame = root.CFrame
    local ptype = hitParticleSettings.particleType
    local emitters = hitParticleTypes[ptype]
    local count = hitParticleCounts[ptype] or 1
    if emitters then
        for _, name in ipairs(emitters) do
            local e = hitParticleEmitters[name]
            if e then
                e:Emit(count)
            end
        end
    end
end

local triggerHitOverlayFunc = function() end

do
    local rs = ReplicatedStorage
    local stats = game:GetService('Stats')
    local hooked = false
    local bloodSplatters = {}
    local onHitCallbacks = {}
    local onShotCallbacks = {}
    local function getPing()
        local ok, ping = pcall(function() return stats.Network.ServerStatsItem['Data Ping']:GetValue() end)
        return ok and ping or 100
    end
    local function getClosestPlayer(radius, pos)
        local dist, closest = radius
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild('HumanoidRootPart')
                if hrp then
                    local d = (hrp.Position - pos).Magnitude
                    if d < dist then closest, dist = plr, d end
                end
            end
        end
        return closest
    end
    local function hasBloodSplatter(plr)
        if not plr or not plr.Character then return false end
        for _, inst in ipairs(plr.Character:GetDescendants()) do
            if (inst.Name=='BloodSplatter' or inst.Name=='BloodParticles' or inst.Name=='BloodParticle')
                and not table.find(bloodSplatters, inst) then
                table.insert(bloodSplatters, inst)
                return true, inst.Parent
            end
        end
        return false
    end
    local function onShot(handle, startPos, endPos)
        for _, cb in ipairs(onShotCallbacks) do pcall(cb, startPos, endPos) end
        local plr = getClosestPlayer(10, endPos)
        if not plr then return end
        local oldHP
        if plr.Character then
            local humanoid = plr.Character:FindFirstChild('Humanoid')
            if humanoid then oldHP = humanoid.Health end
        end
        local waitTime = (getPing()+30)/1000
        task.delay(waitTime, function()
            local hit, part = hasBloodSplatter(plr)
            local hpDecreased = false
            if oldHP and plr.Character then
                local hum = plr.Character:FindFirstChild('Humanoid')
                if hum then hpDecreased = hum.Health < oldHP end
            end
            if hit or hpDecreased then
                for _, cb in ipairs(onHitCallbacks) do pcall(cb, plr, part) end
            end
        end)
    end
    local lastLocalShotTime = 0

    local function listenLocalToolActivation(char)
        if not char then return end
        local function bindTool(tool)
            if tool:IsA("Tool") then
                tool.Activated:Connect(function()
                    lastLocalShotTime = tick()
                end)
            end
        end
        for _, child in ipairs(char:GetChildren()) do bindTool(child) end
        char.ChildAdded:Connect(bindTool)
    end
    if LocalPlayer.Character then listenLocalToolActivation(LocalPlayer.Character) end
    LocalPlayer.CharacterAdded:Connect(listenLocalToolActivation)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Tool") then
                lastLocalShotTime = tick()
            end
        end
    end)

    local function setupHook()
        if hooked then return end
        hooked = true

        pcall(function()
            local rawmt = getrawmetatable and getrawmetatable(game)
            if rawmt then
                local setreadonly = setreadonly or make_writeable
                local oldNamecall = rawmt.__namecall
                if setreadonly then setreadonly(rawmt, false) end
                rawmt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod and getnamecallmethod()
                    local args = {...}
                    if method == "FireServer" then
                        lastLocalShotTime = tick()
                        local arg1 = args[1]
                        if arg1 == "ShootGun" or arg1 == "Bullets" or arg1 == "Hit" or arg1 == "Stab" or arg1 == "Combat" then
                            task.spawn(onShot, args[2], args[3], args[4])
                        end
                    end
                    return oldNamecall(self, ...)
                end)
                if setreadonly then setreadonly(rawmt, true) end
            end
        end)

        local function bindPlayerHealth(plr)
            if plr == LocalPlayer then return end
            local function onChar(char)
                local hum = char:WaitForChild("Humanoid", 3)
                if not hum then return end
                local lastHp = hum.Health
                hum.HealthChanged:Connect(function(newHp)
                    if newHp < lastHp then
                        local myChar = LocalPlayer.Character
                        local myTool = myChar and myChar:FindFirstChildOfClass("Tool")
                        if myChar and myTool then
                            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
                            local targetHrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")

                            local timeSinceAttack = tick() - lastLocalShotTime
                            local isMeleeRange = false
                            if myHrp and targetHrp then
                                isMeleeRange = (targetHrp.Position - myHrp.Position).Magnitude <= 14
                            end

                            if timeSinceAttack <= 0.6 or isMeleeRange then
                                for _, cb in ipairs(onHitCallbacks) do
                                    pcall(cb, plr, targetHrp)
                                end
                            end
                        end
                    end
                    lastHp = newHp
                end)
            end
            if plr.Character then task.spawn(onChar, plr.Character) end
            plr.CharacterAdded:Connect(onChar)
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            bindPlayerHealth(plr)
        end
        Players.PlayerAdded:Connect(bindPlayerHealth)
    end
    table.insert(onHitCallbacks, function(target, part) hit_effects:triggerChams(target) end)
    table.insert(onHitCallbacks, function(target, part) emitHitParticles(target, part) end)
    table.insert(onHitCallbacks, function(target, part) triggerHitOverlayFunc(target, part) end)
    table.insert(onHitCallbacks, function(target, part)
        if showHitNotifyFunc then
            local name = "Target"
            if typeof(target) == "Instance" then
                if target:IsA("Player") then
                    name = target.DisplayName or target.Name
                elseif target:IsA("Model") then
                    local p = Players:GetPlayerFromCharacter(target)
                    name = (p and (p.DisplayName or p.Name)) or target.Name
                else
                    name = target.Name
                end
            elseif type(target) == "string" then
                name = target
            end
            local pName = (part and part.Name) or "Head"
            showHitNotifyFunc(name, pName, nil)
        end
    end)
    table.insert(onShotCallbacks, function(startPos, endPos) bullet_tracers:create(startPos, endPos) end)
    setupHook()
end

