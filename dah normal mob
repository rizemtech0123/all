local tracerLockPlayer = nil

local function GetNearestPlayerSilent()
    if Toggles and Toggles.TracerLockEnable and Toggles.TracerLockEnable.Value then
        if tracerLockPlayer and tracerLockPlayer.Parent and tracerLockPlayer.Character then
            local targetPartName = (SilentAimSettings and SilentAimSettings.TargetPart) or "Head"
            local targetPart = tracerLockPlayer.Character:FindFirstChild(targetPartName)
            if targetPartName == "Legs" then
                targetPart = tracerLockPlayer.Character:FindFirstChild("LeftLowerLeg") or tracerLockPlayer.Character:FindFirstChild("RightLowerLeg") or tracerLockPlayer.Character:FindFirstChild("HumanoidRootPart")
            end
            if not targetPart then
                targetPart = tracerLockPlayer.Character:FindFirstChild("HumanoidRootPart") or tracerLockPlayer.Character:FindFirstChild("Head")
            end
            local hum = tracerLockPlayer.Character:FindFirstChildOfClass("Humanoid")
            if targetPart and hum and hum.Health > 0 then
                local be = tracerLockPlayer.Character:FindFirstChild("BodyEffects")
                local isKO = be and (
                    (be:FindFirstChild("K.O") and be["K.O"].Value == true) or
                    (be:FindFirstChild("KO") and be.KO.Value == true) or
                    (be:FindFirstChild("SDeath") and be.SDeath.Value == true) or
                    (be:FindFirstChild("Dead") and be.Dead.Value == true)
                )
                if not (SilentAimSettings and SilentAimSettings.KOCheck and isKO) then
                    return targetPart
                end
            end
        end

        tracerLockPlayer = nil
        local newPlr = getClosestPlayerToCameraOrMouse(2000)
        if newPlr and newPlr.Character then
            tracerLockPlayer = newPlr
            local targetPartName = (SilentAimSettings and SilentAimSettings.TargetPart) or "Head"
            local targetPart = newPlr.Character:FindFirstChild(targetPartName) or newPlr.Character:FindFirstChild("HumanoidRootPart") or newPlr.Character:FindFirstChild("Head")
            return targetPart
        end
    end

    local strafeActive = Toggles and Toggles.TargetStrafeToggle and Toggles.TargetStrafeToggle.Value
    local lockActive = Toggles and Toggles.TargetLockToggle and Toggles.TargetLockToggle.Value

    if strafeActive or lockActive then
        local activeStrafePlr = (strafeActive and strafeTargetPlayer) or (lockActive and lockTargetPlayer) or getSelectedTarget()
        if activeStrafePlr and activeStrafePlr.Character then
            local targetPartName = (SilentAimSettings and SilentAimSettings.TargetPart) or "Head"
            local targetPart = activeStrafePlr.Character:FindFirstChild(targetPartName) or activeStrafePlr.Character:FindFirstChild("HumanoidRootPart") or activeStrafePlr.Character:FindFirstChild("Head")
            local hum = activeStrafePlr.Character:FindFirstChildOfClass("Humanoid")
            if targetPart and hum and hum.Health > 0 then
                local be = activeStrafePlr.Character:FindFirstChild("BodyEffects")
                local isKO = be and (
                    (be:FindFirstChild("K.O") and be["K.O"].Value == true) or
                    (be:FindFirstChild("KO") and be.KO.Value == true) or
                    (be:FindFirstChild("SDeath") and be.SDeath.Value == true) or
                    (be:FindFirstChild("Dead") and be.Dead.Value == true)
                )
                if not (SilentAimSettings and SilentAimSettings.KOCheck and isKO) then
                    return targetPart
                end
            end
        end
        return nil
    end

    local best, target = math.huge, nil
    local origin = GetFOVOrigin()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHrp then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetPartName = SilentAimSettings.TargetPart
            local targetPart = plr.Character:FindFirstChild(targetPartName)
            if targetPartName == "Legs" then
                targetPart = plr.Character:FindFirstChild("LeftLowerLeg") or plr.Character:FindFirstChild("RightLowerLeg") or hrp
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hrp and targetPart and hum and hum.Health > 0 then
                local dist = (hrp.Position - localHrp.Position).Magnitude
                if dist <= SilentAimSettings.MaxDistance then
                    local be = plr.Character:FindFirstChild("BodyEffects")
                    local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                    local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                    if not (SilentAimSettings.KOCheck and (isKO or isSD)) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                            if fovDist <= SilentAimSettings.FOV and fovDist < best then
                                if SilentAimSettings.WallCheck then
                                    local rayOrigin = Camera.CFrame.Position
                                    local rayDir = targetPart.Position - rayOrigin
                                    local rayParams = RaycastParams.new()
                                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                    local ignoreList = {LocalPlayer.Character, plr.Character, Camera}
                                    if workspace:FindFirstChild("Ignored") then table.insert(ignoreList, workspace.Ignored) end
                                    rayParams.FilterDescendantsInstances = ignoreList
                                    local hitResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
                                    if not hitResult then
                                        best = fovDist
                                        target = targetPart
                                    end
                                else
                                    best = fovDist
                                    target = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

