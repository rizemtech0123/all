local oldToolGrips = {}

local function resetToolGrips()
    for tool, origGrip in pairs(oldToolGrips) do
        if tool and tool.Parent then
            pcall(function() tool.Grip = origGrip end)
        end
    end
    oldToolGrips = {}
end

