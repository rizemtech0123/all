        end
    end
end

local function lockOnTarget(plr)
    if not plr or not plr.Parent then return end
    lockedTargetPlayer = plr
    isLockActive = true
    currentDotTarget = plr
    dotEnabledState = true
    ensureDotPartExists()
    if Toggles.EnableSilent and not Toggles.EnableSilent.Value then
        Toggles.EnableSilent:SetValue(true)
    end
    if Toggles.DotTargetEnable and not Toggles.DotTargetEnable.Value then
        Toggles.DotTargetEnable:SetValue(true)
    end
    wasTargetAvailable = true
    Library:Notify("Locked Silent Dot on: " .. (plr.DisplayName or plr.Name), 3)
end

local function unlockTarget()
    local oldName = lockedTargetPlayer and (lockedTargetPlayer.DisplayName or lockedTargetPlayer.Name)
    lockedTargetPlayer = nil
    isLockActive = false
    wasTargetAvailable = false
    cleanupDotTarget()
    if oldName then
        Library:Notify("Unlocked Target Dot from: " .. oldName, 3)
    else
        Library:Notify("Unlocked Target Dot", 2)
    end
end

local function toggleDotLock()
    if tick() - lastDotToggleTime < 0.25 then return end
    lastDotToggleTime = tick()

    if not Toggles.DotTargetEnable or not Toggles.DotTargetEnable.Value then return end
    if not SilentAimSettings.Enabled then
        if Toggles.EnableSilent then
            Toggles.EnableSilent:SetValue(true)
        else
            SilentAimSettings.Enabled = true
        end
    end

    if dotEnabledState then
        cleanupDotTarget()
        Library:Notify("Dot Target: Unlocked", 2)
    else
        local targetPlr = getClosestPlayerToCursorDot()
        if not targetPlr then
            targetPlr = getSelectedTarget() or getClosestPlayerToCameraOrMouse(2000)
        end
        if targetPlr and targetPlr.Character then
            ensureDotPartExists()
            currentDotTarget = targetPlr
            dotEnabledState = true
            Library:Notify("Dot Target Locked: " .. (targetPlr.DisplayName or targetPlr.Name), 2)
        else
            Library:Notify("Dot Target: No target near cursor!", 2)
        end
    end
end
