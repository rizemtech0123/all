    _G.rb_steppedMove = function(root, targetCF)
        if not root or not root.Parent then return end
        local dist = (root.CFrame.Position - targetCF.Position).Magnitude
        if dist < 4 then
            pcall(function()
                root.CFrame = targetCF
                root.AssemblyLinearVelocity = Vector3.zero
            end)
            return
        end
        local steps = math.clamp(math.floor(dist / 15), 1, 4)
        local startCF = root.CFrame
        local dir = (targetCF.Position - startCF.Position).Unit
        pcall(function()
            root.AssemblyLinearVelocity = dir * math.clamp(dist * 3, 30, 90)
        end)
        for i = 1, steps do
            local alpha = i / steps
            local midPos = startCF.Position:Lerp(targetCF.Position, alpha)
            local midCF  = CFrame.new(midPos, midPos + (targetCF.LookVector))
            pcall(function()
                root.CFrame = midCF
                if i < steps then
                    root.AssemblyLinearVelocity = dir * math.clamp(dist * 3 * (1 - alpha * 0.5), 20, 90)
                else
                    root.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            if i < steps then RunService.Heartbeat:Wait() end
        end
        pcall(function() root.CFrame = targetCF end)
    end

