local function avoidRPG(rpgPart)
    if not rpgPart then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local oldParent = rpgPart.Parent and rpgPart.Parent.Parent

    while Toggles.AntiRPG and Toggles.AntiRPG.Value and rpgPart and rpgPart.Parent and rpgPart.Parent.Parent == oldParent do
        local currentChar = LocalPlayer.Character
        local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        if not currentHrp then break end

        local dist = (rpgPart.Position - currentHrp.Position).Magnitude
        if dist < 35 then
            pcall(function()

                currentHrp.CFrame = currentHrp.CFrame + (rpgPart.CFrame.LookVector * 40 * Vector3.new(1, 0, 1))
            end)
            task.wait(0.2)
            break
        end
        task.wait(0.02)
    end
end

