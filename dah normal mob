        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.ZIndex = 11

        local dragging = false
        local dragStartInput = nil
        local frameStartX = 0
        local frameStartY = 0
        local moveSum = 0
        local isClick = false

        btn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStartInput = inp.Position
                frameStartX = frame.Position.X.Offset
                frameStartY = frame.Position.Y.Offset
                moveSum = 0
                isClick = true
            end
        end)

        UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch then
                local delta = inp.Position - dragStartInput
                moveSum = moveSum + math.abs(delta.X) + math.abs(delta.Y)
                if moveSum > 10 then
                    isClick = false
                    local vp = workspace.CurrentCamera.ViewportSize
                    local nx = math.clamp(frameStartX + delta.X, 0, vp.X - frame.AbsoluteSize.X)
                    local ny = math.clamp(frameStartY + delta.Y, 0, vp.Y - frame.AbsoluteSize.Y)
                    frame.Position = UDim2.new(0, nx, 0, ny)
                end
            end
        end)

        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        return frame, btn, function() return isClick end, function() isClick = false end
    end

    local vp = workspace.CurrentCamera.ViewportSize

    local isInitOn = Toggles.EnableRapidFire and Toggles.EnableRapidFire.Value == true
    local rapidOn = isInitOn
    _G._mobileRFActive = isInitOn
    local lastRfe = isInitOn

    local rapidFrame, rapidBtn, rapidWasClick, rapidClearClick =
        makeDraggableBtn("RapidFireMobileBtn", isInitOn and "Rapid Fire: ON" or "Rapid Fire: OFF", vp.X - 165, vp.Y - 216)
    rapidFrame.Visible = isInitOn
    if isInitOn then
        rapidFrame.BackgroundColor3 = COLOR_ON_RAPID
    end

    local camFrame, camBtn, camWasClick, camClearClick =
        makeDraggableBtn("CamLockMobileBtn", "CamLock: OFF", vp.X - 165, vp.Y - 164)

    local strafeFrame, strafeBtn, strafeWasClick, strafeClearClick =
        makeDraggableBtn("TargetStrafeMobileBtn", "Target Strafe: OFF", vp.X - 165, vp.Y - 112)

    local rageFrame, rageBtn, rageWasClick, rageClearClick =
        makeDraggableBtn("RagebotMobileBtn", "Ragebot: OFF", vp.X - 165, vp.Y - 60)

    rapidBtn.MouseButton1Click:Connect(function()
        if not rapidWasClick() then return end
        rapidClearClick()
        rapidOn = not rapidOn
        if _G._setRapidFireState then
            _G._setRapidFireState(rapidOn)
        else
            _G._mobileRFActive = rapidOn
        end
        rapidBtn.Text = rapidOn and "Rapid Fire: ON" or "Rapid Fire: OFF"
        tweenBg(rapidFrame, rapidOn and COLOR_ON_RAPID or COLOR_OFF)
    end)

    local camOn = false
    camBtn.MouseButton1Click:Connect(function()
        if not camWasClick() then return end
        camClearClick()
        camOn = not camOn
        local CamLockSettings = getgenv().CamLockSettings
        if CamLockSettings then
            CamLockSettings.MobileActive = camOn
            CamLockSettings.Sticky = camOn
            if not camOn then CamLockSettings.StickyTarget = nil end
        end
        camBtn.Text = camOn and "CamLock: ON" or "CamLock: OFF"
        tweenBg(camFrame, camOn and COLOR_ON_CAM or COLOR_OFF)
    end)

    local strafeOn = false
    strafeBtn.MouseButton1Click:Connect(function()
        if not strafeWasClick() then return end
        strafeClearClick()
        if _G._mobileTargetStrafeToggle then
            _G._mobileTargetStrafeToggle()
            task.wait(0.05)
            local state = _G._getStrafeState and _G._getStrafeState()
            strafeOn = (state == true)
            strafeBtn.Text = strafeOn and "Target Strafe: ON" or "Target Strafe: OFF"
            tweenBg(strafeFrame, strafeOn and COLOR_ON_STRAFE or COLOR_OFF)
        end
    end)

    local rageOn = false
    rageBtn.MouseButton1Click:Connect(function()
        if not rageWasClick() then return end
        rageClearClick()
        rageOn = not rageOn
        local rb = _G.RB
        if rb then
            rb.active = rageOn
        end
        rageBtn.Text = rageOn and "Ragebot: ON" or "Ragebot: OFF"
        tweenBg(rageFrame, rageOn and COLOR_ON_RAG or COLOR_OFF)
    end)

    RunService.Heartbeat:Connect(function()
        local rfe = Toggles.EnableRapidFire and Toggles.EnableRapidFire.Value == true
        rapidFrame.Visible = rfe
        if rfe and not lastRfe then
            rapidOn = true
            if _G._setRapidFireState then _G._setRapidFireState(true) else _G._mobileRFActive = true end
            rapidBtn.Text = "Rapid Fire: ON"
            tweenBg(rapidFrame, COLOR_ON_RAPID)
        elseif not rfe and lastRfe then
            rapidOn = false
            if _G._setRapidFireState then _G._setRapidFireState(false) else _G._mobileRFActive = false end
            rapidBtn.Text = "Rapid Fire: OFF"
            rapidFrame.BackgroundColor3 = COLOR_OFF
        end
        lastRfe = rfe

        local ce = Toggles.EnableCamLock and Toggles.EnableCamLock.Value == true
        camFrame.Visible = ce
        if not ce and camOn then
            camOn = false
            local CamLockSettings = getgenv().CamLockSettings
            if CamLockSettings then
                CamLockSettings.MobileActive = false
                CamLockSettings.StickyTarget = nil
            end
            camBtn.Text = "CamLock: OFF"
            camFrame.BackgroundColor3 = COLOR_OFF
        end

        local se = Toggles.TargetStrafeToggle and Toggles.TargetStrafeToggle.Value == true
        strafeFrame.Visible = se
        if not se and strafeOn then
            strafeOn = false
            if _G._mobileTargetStrafeToggle and _G._getStrafeState and _G._getStrafeState() then
                _G._mobileTargetStrafeToggle()
            end
            strafeBtn.Text = "Target Strafe: OFF"
            strafeFrame.BackgroundColor3 = COLOR_OFF
        else
            local curStrafe = _G._getStrafeState and _G._getStrafeState()
            if se and curStrafe ~= nil and curStrafe ~= strafeOn then
                strafeOn = curStrafe
                strafeBtn.Text = strafeOn and "Target Strafe: ON" or "Target Strafe: OFF"
                tweenBg(strafeFrame, se and COLOR_ON_STRAFE or COLOR_OFF)
            end
        end

        local re = Toggles.ragebotenabled and Toggles.ragebotenabled.Value == true
        rageFrame.Visible = re
        if not re and rageOn then
            rageOn = false
            local rb = _G.RB
            if rb then rb.active = false end
            rageBtn.Text = "Ragebot: OFF"
            rageFrame.BackgroundColor3 = COLOR_OFF
        end
    end)
end)
