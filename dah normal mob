    dotEnabledState = false
end

local function ensureDotPartExists()
    local dotColor = Options.DotTargetColor and Options.DotTargetColor.Value or Color3.fromRGB(255, 30, 30)
    if not dotPart or not dotPart.Parent then
        local part = Instance.new("Part")
        part.Name = "DotTargetMarkerPart"
        part.Anchored = true
        part.CanCollide = false
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.Transparency = 1
        part.CFrame = CFrame.new(0, 9999, 0)
        part.Parent = workspace

        local bgui = Instance.new("BillboardGui")
        bgui.Name = "PP"
        bgui.Adornee = part
        bgui.Size = UDim2.new(0, 16, 0, 16)
        bgui.AlwaysOnTop = true
        bgui.LightInfluence = 0
        bgui.Parent = part

        local frame = Instance.new("Frame", bgui)
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 0
        frame.BackgroundColor3 = dotColor
        frame.BorderSizePixel = 0

        local corner = Instance.new("UICorner", frame)
        corner.CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Color3.fromRGB(0, 0, 0)
