local targetHealth = {}

local function addTargetFromShot()
    local mousePos = UserInputService:GetMouseLocation()
    local closestPlayer = nil
    local closestDist = 200
    local hitPartName = "Head"

    local cam = workspace.CurrentCamera
    if cam then
        local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        if LocalPlayer.Character then
            rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
        end
        rayParams.IgnoreWater = true
        local res = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
        if res and res.Instance then
            local p = Players:GetPlayerFromCharacter(res.Instance.Parent) or Players:GetPlayerFromCharacter(res.Instance.Parent.Parent)
            if p and p ~= LocalPlayer then
                closestPlayer = p
                hitPartName = res.Instance.Name
            end
        end
    end

    if not closestPlayer then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestPlayer = player
                            local mDist = 9999
                            for _, part in ipairs(player.Character:GetChildren()) do
                                if part:IsA("BasePart") then
                                    local pPos, pOn = Camera:WorldToViewportPoint(part.Position)
                                    if pOn then
                                        local d = (Vector2.new(pPos.X, pPos.Y) - mousePos).Magnitude
                                        if d < mDist then
                                            mDist = d
                                            hitPartName = part.Name
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if closestPlayer then
        myTargets[closestPlayer.UserId] = { player = closestPlayer, part = hitPartName }
        if closestPlayer.Character then
            local hum = closestPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                targetHealth[closestPlayer.UserId] = hum.Health
            end
        end
        task.delay(3, function()
            myTargets[closestPlayer.UserId] = nil
            targetHealth[closestPlayer.UserId] = nil
        end)
    end
end

