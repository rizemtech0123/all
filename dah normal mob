                    local upperTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")

                    if not isKO then
                        broughtKOCharacters[tChar] = nil
                    end

                    if isKO and upperTorso and not broughtKOCharacters[tChar] then
                        sentryBusy = true
                        local savedCF = hrp.CFrame
                        local isBringing = true
                        local isGrabbed = false

                        local noclipConn = RunService.Stepped:Connect(function()
                            if not isBringing then return end
                            local c = LocalPlayer.Character
                            if c then
                                for _, p in ipairs(c:GetDescendants()) do
                                    if p:IsA("BasePart") then p.CanCollide = false end
                                end
                            end
                            local t = target and target.Character
                            if t then
                                for _, p in ipairs(t:GetDescendants()) do
                                    if p:IsA("BasePart") then p.CanCollide = false end
                                end
                            end
                        end)

                        local lastGrabTick = 0
                        local bringConn = RunService.Heartbeat:Connect(function()
                            if not isBringing or not target or not target.Character then return end
                            local c = LocalPlayer.Character
                            local root = c and c:FindFirstChild("HumanoidRootPart")
                            if not root then return end

                            local tc = target.Character
                            local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart")
                            if not ut then return end

                            if tc:FindFirstChild("GRABBING_CONSTRAINT") or (c and c:FindFirstChild("GRABBING_CONSTRAINT")) then
                                isGrabbed = true
                                isBringing = false
                                return
                            end

                            if sethiddenproperty then
                                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                            end

                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                                root.Velocity = Vector3.zero
                                root.RotVelocity = Vector3.zero
                                root.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.5, 0))
                            end)

                            if tick() - lastGrabTick >= 0.35 then
                                lastGrabTick = tick()
                                pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                            end
                        end)

                        local start = os.clock()
                        while isBringing and (os.clock() - start < 8) do
                            task.wait(0.05)
                            if target and target.Character then
                                local tc = target.Character
                                local mc = LocalPlayer.Character
                                if (tc and tc:FindFirstChild("GRABBING_CONSTRAINT")) or (mc and mc:FindFirstChild("GRABBING_CONSTRAINT")) then
                                    isGrabbed = true
                                    break
                                end
                            end
                        end

                        isBringing = false
                        if bringConn then bringConn:Disconnect() end
                        if noclipConn then noclipConn:Disconnect() end

                        local endChar = LocalPlayer.Character
                        local endHrp = endChar and endChar:FindFirstChild("HumanoidRootPart")

                        if sethiddenproperty and endHrp then
                            pcall(function() sethiddenproperty(endHrp, "PhysicsRepRootPart", nil) end)
                        end

                        if isGrabbed and endHrp and savedCF then
                            endHrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                            endHrp.AssemblyLinearVelocity = Vector3.zero
                            endHrp.AssemblyAngularVelocity = Vector3.zero
                            endHrp.Velocity = Vector3.zero
                            endHrp.RotVelocity = Vector3.zero

                            task.wait(0.35)
                            pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                            task.wait(0.35)
                            Library:Notify("Brought KO target to your position!", 3)
                        end

                        if endChar then
                            for _, p in ipairs(endChar:GetDescendants()) do
                                if p:IsA("BasePart") then
                                    p.CanCollide = true
                                    p.AssemblyLinearVelocity = Vector3.zero
                                    p.AssemblyAngularVelocity = Vector3.zero
                                    p.Velocity = Vector3.zero
                                    p.RotVelocity = Vector3.zero
                                end
                            end
                        end

                        broughtKOCharacters[tChar] = true
                        sentryBusy = false
                    end
                end
            end
            task.wait(0.3)
        end
    end)

