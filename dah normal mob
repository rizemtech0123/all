local function toggleStrafeLock()
    if not Toggles.TargetStrafeToggle or not Toggles.TargetStrafeToggle.Value then return end
    _G._mobileStrafeActive = not _G._mobileStrafeActive
    targetStrafeSettings.Enabled = _G._mobileStrafeActive
    if strafeConn then strafeConn:Disconnect() strafeConn = nil end
    if targetStrafeSettings.Enabled then
        strafeTargetPlayer = findNewStrafeTarget()
        if strafeTargetPlayer then
            Library:Notify("Target Strafe locked onto: " .. (strafeTargetPlayer.DisplayName or strafeTargetPlayer.Name), 3)
        else
            Library:Notify("No target found in camera view", 3)
        end
        strafeConn = RunService.RenderStepped:Connect(function(dt)
            if not targetStrafeSettings.Enabled or not _G._mobileStrafeActive or getgenv().Flying then
                if strafeConn then strafeConn:Disconnect() strafeConn = nil end
                return
            end
            if not strafeTargetPlayer or not strafeTargetPlayer.Character then return end
            local myChar = LocalPlayer.Character
            local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tR = strafeTargetPlayer.Character:FindFirstChild("HumanoidRootPart") or strafeTargetPlayer.Character:FindFirstChild("UpperTorso") or strafeTargetPlayer.Character:FindFirstChild("Head")
            if root and tR then
                orbitAngle = orbitAngle + dt * targetStrafeSettings.Speed * 2 * math.pi
                local rad = targetStrafeSettings.Distance
                local hgt = targetStrafeSettings.Height
                local mode = targetStrafeSettings.Mode or "Orbit"

                local tPos = tR.Position
                local wantPos
                local targetCF

                if mode == "Above Upside Down Spin" then
                    wantPos = tPos + Vector3.new(0, math.max(hgt, 6), 0)
                    targetCF = CFrame.new(wantPos) * CFrame.Angles(math.rad(180), orbitAngle * 6, 0)
                elseif mode == "Above Target" then
                    wantPos = tPos + Vector3.new(0, math.max(hgt, 6), 0)
                    targetCF = CFrame.lookAt(wantPos, tPos)
                elseif mode == "Under Target" then
                    wantPos = tPos - Vector3.new(0, math.abs(hgt) > 0 and math.abs(hgt) or 6, 0)
                    targetCF = CFrame.lookAt(wantPos, tPos)
                elseif mode == "Spiral Orbit" then
                    local dynamicRad = rad + math.sin(orbitAngle) * 3
                    local dynamicHgt = hgt + math.cos(orbitAngle * 1.5) * 4
                    wantPos = tPos + Vector3.new(math.sin(orbitAngle) * dynamicRad, dynamicHgt, math.cos(orbitAngle) * dynamicRad)
                    targetCF = CFrame.lookAt(wantPos, tPos)
                else
                    wantPos = tPos + Vector3.new(math.sin(orbitAngle) * rad, hgt, math.cos(orbitAngle) * rad)
                    targetCF = CFrame.lookAt(wantPos, tPos)
                end

                root.CFrame = targetCF
            end
        end)
    else
        strafeTargetPlayer = nil
        Library:Notify("Target Strafe: OFF", 2)
    end
end
