local function getClosestPlayerToCameraOrMouse(maxDistance)
    maxDistance = maxDistance or 500
    if UserInputService:GetFocusedTextBox() then return nil end
    local cam = workspace.CurrentCamera or Camera
    if not cam then return nil end

    local mousePos = UserInputService:GetMouseLocation()
    local viewportCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer and LocalPlayer.Character then
        rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
    end
    rayParams.IgnoreWater = true

    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
    if result and result.Instance then
        local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
        if hitChar then
            local plr = Players:GetPlayerFromCharacter(hitChar)
            if plr and plr ~= LocalPlayer then
                return plr
            end
        end
    end

    local closestPlr = nil
    local closestDist = maxDistance

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                if onScreen and screenPos.Z > 0 then
                    local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    local centerDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                    local dist = math.min(mouseDist, centerDist * 1.2)
                    if dist < closestDist then
                        closestDist = dist
                        closestPlr = player
                    end
                end
            end
        end
    end

    return closestPlr
end

