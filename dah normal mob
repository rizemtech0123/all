            end
            if _G.TargetLockDot and _G.TargetLockDot.lockedPlr and _G.TargetLockDot.lockedPlr:IsA("Player") then
                return _G.TargetLockDot.lockedPlr
            end
            if rb and rb.targets then
                for _, plr in ipairs(rb.targets) do
                    if plr and plr:IsA("Player") and plr:IsDescendantOf(Players) then
                        return plr
                    end
                end
            end
            if Options and Options.ragebottargets and type(Options.ragebottargets.Value) == "table" then
                for k, v in pairs(Options.ragebottargets.Value) do
                    local entry = nil
                    if type(k) == "number" and type(v) == "string" then
                        entry = v
                    elseif type(k) == "string" and v == true then
                        entry = k
                    end
                    if entry then
                        local cleanName = entry:match("@([^%s%)]+)") or entry
                        local p = Players:FindFirstChild(cleanName)
                        if p and p:IsA("Player") then return p end
                    end
                end
            end
            return nil
